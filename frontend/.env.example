# VERITAS AI Frontend Local Configuration Example
HARNESS_URL=http://127.0.0.1:8002
PORT=3000

# Mode: leave unset (or set "demo") for the original demo harness.
# Set to "enterprise" to use OIDC/session cookies, CSRF and IdP roles.
NEXT_PUBLIC_VERITAS_MODE=demo
# Optional, automated tests only: redirect login to /api/v1/auth/test-login.
NEXT_PUBLIC_VERITAS_TEST_MODE=0

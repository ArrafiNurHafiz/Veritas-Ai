# =============================================================================
# VERITAS AI — Enterprise Environment Configuration (Example)
# =============================================================================

# 1. Enterprise Harness Gateway (:8002) & Database
DATABASE_URL=sqlite:///./enterprise.db
VERITAS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VERITAS_INTERNAL_TOKEN=dev-internal
# Generate 64 hex chars for persistent Ed25519 receipts across restarts (e.g. openssl rand -hex 32)
VERITAS_SIGNING_SEED=
VERITAS_LOG_JSON=0
VERITAS_SESSION_TTL_SECONDS=43200
VERITAS_COOKIE_SECURE=0
VERITAS_COOKIE_SAMESITE=lax

# 2. SSO / KMS Bypass & Demo Login (set to 0 in strict production)
VERITAS_SSO_BYPASS=1
VERITAS_KMS_BYPASS=1
VERITAS_AUTH_TEST_MODE=1

# 3. LLM Integration (OpenAI-compatible / 9router / OpenRouter; never hardcode secrets)
VERITAS_LLM_BASE_URL=
VERITAS_LLM_API_KEY=
VERITAS_LLM_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
VERITAS_PUBLIC_URL=http://localhost:3000

# 4. Approval Email Notifications (SMTP)
# For local sandbox testing, start mail_sandbox (:1025 SMTP / :8025 Web Inbox)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@veritas.local
SMTP_USE_TLS=0
VERITAS_APPROVAL_NOTIFY_EMAILS=approver@veritas.local,admin@veritas.local

# 5. ERP Connector Preset (local_ledger | webhook | odoo | sap)
# For local sandbox testing, point VERITAS_ERP_WEBHOOK_URL to http://127.0.0.1:8003/api/erp/webhook
# For real Odoo 17 CE (docker compose -f docker-compose.odoo.yml up -d):
#   VERITAS_ERP_ADAPTER=odoo, VERITAS_ERP_WEBHOOK_URL=http://127.0.0.1:8069, VERITAS_ODOO_DB=veritas_odoo
VERITAS_ERP_ADAPTER=webhook
VERITAS_ERP_WEBHOOK_URL=http://127.0.0.1:8003/api/erp/webhook
VERITAS_ERP_API_KEY=
VERITAS_ERP_HMAC_SECRET=
VERITAS_ALLOW_INSECURE_WEBHOOKS=1
VERITAS_ODOO_DB=
VERITAS_ODOO_USERNAME=admin
VERITAS_ODOO_PASSWORD=admin

# 6. Agent Service (:8001) Integration
VERITAS_AGENT_URL=http://127.0.0.1:8001
VERITAS_AGENT_TOKEN=dev-agent-token

# 7. Next.js Frontend (:3000) Target
HARNESS_URL=http://127.0.0.1:8002
NEXT_PUBLIC_HARNESS_URL=http://127.0.0.1:8002
NEXT_PUBLIC_VERITAS_MODE=enterprise
NEXT_PUBLIC_VERITAS_TEST_MODE=1

# 8. Optional EVM Anchor
VERITAS_ANCHOR_RPC_URL=
VERITAS_ANCHOR_FROM=
